*.cmd text eol=crlf
*.ps1 text eol=crlf
# Vendored QorTime contracts are byte-pinned (contracts/SHA256SUMS, raw SHA-256).
# Windows runners set core.autocrlf=true; eol=lf keeps the checkout equal to the git blob.
# contracts/* covers files directly in contracts/; contracts/** covers nested paths.
contracts/* text eol=lf
contracts/** text eol=lf
# Byte-pinned test goldens (sha256 checked in the test): no CRLF conversion on Windows checkouts.
sidecar/fixtures/highlights_golden_*.txt -text
# Byte-pinned S2S body cue files (FROZEN-fusion-params.json sha256 is a code constant; the frozen file
# records the sha256 of models.manifest.json and the fusion code): keep Windows checkouts equal to the git blob.
tools/s2s_bodycue/** text eol=lf
