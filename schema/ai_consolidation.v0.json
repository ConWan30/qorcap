{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conwan30.github.io/qorcap/schema/ai_consolidation.v0.json",
  "title": "QorCap AI consolidation v0",
  "description": "Offline batch record. decision is promoted or discarded. Not a receipt field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidate", "current", "labelled_matches", "metrics", "per_context", "decision", "reason", "idle", "during_capture", "referee_identical"],
  "properties": {
    "schema": {"const": "qorcap-ai-consolidation/v0"},
    "candidate": {"$ref": "#/$defs/version"},
    "current": {"$ref": "#/$defs/version"},
    "labelled_matches": {"type": "array", "items": {"$ref": "#/$defs/labelled"}},
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate", "current"],
      "properties": {
        "candidate": {"$ref": "#/$defs/metric"},
        "current": {"$ref": "#/$defs/metric"}
      }
    },
    "per_context": {"type": "array", "items": {"$ref": "#/$defs/context_row"}},
    "decision": {"enum": ["promoted", "discarded"]},
    "reason": {"enum": ["strict_improvement", "during_capture", "not_idle", "referee_checks_differ", "no_labelled_matches", "context_regression", "not_strict_improvement"]},
    "idle": {"type": "boolean"},
    "during_capture": {"type": "boolean"},
    "referee_identical": {"type": "boolean"}
  },
  "$defs": {
    "version": {
      "type": "object", "additionalProperties": false,
      "required": ["model_version", "calibration_version"],
      "properties": {
        "model_version": {"type": "string", "pattern": "^[A-Za-z0-9._+-]{1,64}$"},
        "calibration_version": {"type": "string", "pattern": "^[A-Za-z0-9._+-]{1,64}$"}
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["correct_weight", "total_weight", "accuracy_permille"],
      "properties": {
        "correct_weight": {"type": "integer", "minimum": 0},
        "total_weight": {"type": "integer", "minimum": 0},
        "accuracy_permille": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    },
    "labelled": {
      "type": "object", "additionalProperties": false,
      "required": ["match_id", "source", "weight", "game", "controller_family", "console"],
      "properties": {
        "match_id": {"type": "string"},
        "source": {"enum": ["referee", "human_review"]},
        "weight": {"enum": [1, 3]},
        "game": {"type": "string"},
        "controller_family": {"type": "string"},
        "console": {"type": "string"}
      }
    },
    "context_row": {
      "type": "object", "additionalProperties": false,
      "required": ["game", "controller_family", "console", "candidate", "current", "regression"],
      "properties": {
        "game": {"type": "string"},
        "controller_family": {"type": "string"},
        "console": {"type": "string"},
        "candidate": {"$ref": "#/$defs/metric"},
        "current": {"$ref": "#/$defs/metric"},
        "regression": {"type": "boolean"}
      }
    }
  }
}
