{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conwan30.github.io/qorcap/schema/ai_outcome.v0.json",
  "title": "QorCap AI outcome v0",
  "description": "One line of ai_outcomes.jsonl. A proposal joined to referee or owner labels. Not a receipt field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "proposal_id", "match_id", "model_version", "calibration_version", "kind", "abstain", "context", "relates_to", "checks", "outcome", "pairing", "source", "weight", "trainable", "reason", "grounding", "misses", "referee_outcome"],
  "properties": {
    "schema": {"const": "qorcap-ai-outcome/v0"},
    "proposal_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$"},
    "match_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$"},
    "model_version": {"type": "string", "pattern": "^[A-Za-z0-9._+-]{1,64}$"},
    "calibration_version": {"type": "string", "pattern": "^[A-Za-z0-9._+-]{1,64}$"},
    "kind": {"enum": ["score_read", "event_label", "clip_pick", "explanation"]},
    "abstain": {"type": "boolean"},
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["game", "controller_family", "console", "capture"],
      "properties": {
        "game": {"type": "string"},
        "controller_family": {"type": "string"},
        "console": {"type": "string"},
        "capture": {"type": "string"}
      }
    },
    "relates_to": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "checks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "ran", "state"],
        "properties": {
          "id": {"type": "string"},
          "ran": {"type": "boolean"},
          "state": {"enum": ["pass", "partial", "fail", null]}
        }
      }
    },
    "outcome": {"enum": ["confirmed", "contradicted", "unverifiable"]},
    "pairing": {"enum": ["confirmed", "contradicted", "unverifiable", "not_applicable"]},
    "source": {"enum": ["referee", "human_review"]},
    "weight": {"enum": [1, 3]},
    "trainable": {"type": "boolean"},
    "reason": {"enum": ["value_match", "value_mismatch", "check_failed", "check_not_run", "no_independent_value", "partial_check", "checks_incomplete", "abstain", "grounding_miss", "citations_match"]},
    "grounding": {"enum": ["grounded", "miss", "not_applicable"]},
    "misses": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["check_id", "reason", "claimed", "actual"],
        "properties": {
          "check_id": {"type": "string"},
          "reason": {"enum": ["not_run", "state_mismatch"]},
          "claimed": {"enum": ["pass", "partial", "fail"]},
          "actual": {"enum": ["pass", "partial", "fail", null]}
        }
      }
    },
    "referee_outcome": {"enum": ["confirmed", "contradicted", "unverifiable", "absent"]}
  }
}
