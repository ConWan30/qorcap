{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conwan30.github.io/qorcap/schema/template_provenance.v0.json",
  "title": "QorCap template provenance v0",
  "description": "Internal record of which match a glyph template was cut from. Not a receipt.v0 field and not a qorcap-bundle field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "harvest_script", "harvest_version", "templates"],
  "properties": {
    "schema": {"const": "qorcap-template-provenance/v0"},
    "harvest_script": {"const": "tools/harvest_templates.py"},
    "harvest_version": {"type": "string", "pattern": "^[0-9]+$"},
    "templates": {
      "type": "array",
      "items": {"$ref": "#/$defs/template"}
    }
  },
  "$defs": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "sha256", "role", "label", "profile", "source_match_id",
        "t_ms", "frame_index", "harvest_version", "harvest_date"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_./+-]+$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"enum": ["score", "clock", "quarter", "banner", "end_menu"]},
        "label": {"type": "string", "pattern": "^[A-Za-z0-9]{1,16}$"},
        "profile": {
          "enum": ["standard", "end_menu", "monday_night", "sunday_night", "thursday_night", "psn"]
        },
        "source_match_id": {"type": "string", "pattern": "^[0-9]{6}$"},
        "t_ms": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
        "frame_index": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
        "harvest_version": {"type": "string", "pattern": "^[0-9]+$"},
        "harvest_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      },
      "anyOf": [
        {"properties": {"t_ms": {"type": "integer"}}, "required": ["t_ms"]},
        {"properties": {"frame_index": {"type": "integer"}}, "required": ["frame_index"]}
      ]
    }
  }
}
