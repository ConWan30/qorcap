{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conwan30.github.io/qortime/schema/receipt.v0.json",
  "title": "QorTime receipt v0",
  "description": "Signed match-result receipt. Signed bytes = RFC 8785 JCS of the object without 'signatures'. Only strings, safe integers, booleans, null, arrays and objects are allowed (no floats). Ed25519 signatures by every player and the referee.",
  "type": "object",
  "required": ["schema", "match", "result", "players", "referee", "challenges", "checkpoints", "agreement", "signals", "trust_tier", "signatures"],
  "additionalProperties": false,
  "$defs": {
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hex128": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
    "keyid": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "role": {"enum": ["home", "away"]},
    "ms": {"type": "integer", "minimum": 0},
    "sig": {"type": "object", "required": ["key_id", "sig"], "additionalProperties": false,
            "properties": {"key_id": {"$ref": "#/$defs/keyid"}, "sig": {"$ref": "#/$defs/hex128"}}},
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["seq", "t_ms", "frames_hash", "input_hash", "prev", "hash", "referee_ts_ms", "referee_sig"],
      "properties": {
        "seq": {"type": "integer", "minimum": 0}, "t_ms": {"$ref": "#/$defs/ms"},
        "frames_hash": {"$ref": "#/$defs/hex64"}, "input_hash": {"$ref": "#/$defs/hex64"},
        "prev": {"$ref": "#/$defs/hex64"}, "hash": {"$ref": "#/$defs/hex64"},
        "referee_ts_ms": {"$ref": "#/$defs/ms"}, "referee_sig": {"$ref": "#/$defs/hex128"}
      }
    }
  },
  "properties": {
    "schema": {"const": "qor-receipt/v0"},
    "match": {
      "type": "object", "additionalProperties": false,
      "required": ["match_id", "game", "platform", "scorebug_profile", "mode", "started_ms", "ended_ms"],
      "properties": {
        "match_id": {"type": "string", "minLength": 1}, "game": {"type": "string"}, "platform": {"type": "string"},
        "scorebug_profile": {"type": "string"}, "mode": {"enum": ["dual", "single"]},
        "started_ms": {"$ref": "#/$defs/ms"}, "ended_ms": {"$ref": "#/$defs/ms"}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["home_score", "away_score", "quarter", "final_t_ms", "winner", "method"],
      "properties": {
        "home_score": {"type": "integer", "minimum": 0}, "away_score": {"type": "integer", "minimum": 0},
        "quarter": {"type": "integer", "minimum": 4}, "final_t_ms": {"$ref": "#/$defs/ms"},
        "winner": {"$ref": "#/$defs/role"},
        "method": {"enum": ["agreed_scorebug_final", "end_menu_read", "last_scorebug_read_unconfirmed"]},
        "final_basis": {"enum": ["clock_zero", "scorebug_gone", "final_screen", "end_menu"]},
        "final_confirmed": {"type": "boolean"},
        "scorebug_last": {"type": "object", "additionalProperties": false, "required": ["home_score", "away_score"],
                          "properties": {"home_score": {"type": "integer", "minimum": 0}, "away_score": {"type": "integer", "minimum": 0},
                                         "quarter": {"type": "integer"}, "t_ms": {"$ref": "#/$defs/ms"}}},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "players": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {"type": "object", "additionalProperties": false, "required": ["role", "player_id", "pubkey", "key_kind"],
                "properties": {"role": {"$ref": "#/$defs/role"}, "player_id": {"type": "string"},
                               "pubkey": {"$ref": "#/$defs/hex64"}, "key_kind": {"enum": ["software", "software-file", "tpm"]}}}
    },
    "referee": {"type": "object", "additionalProperties": false, "required": ["pubkey", "key_id", "key_kind"],
                "properties": {"pubkey": {"$ref": "#/$defs/hex64"}, "key_id": {"$ref": "#/$defs/keyid"}, "key_kind": {"type": "string"},
        "delegation": {"type": "object", "description": "Root-signed qortime-referee-delegation/v1 certificate for this (online) key; see docs/REFEREE_KEYS.md.", "required": ["type", "serial", "root_key_id", "delegate_pubkey", "scope", "not_before_ms", "not_after_ms", "sig"]}}},
    "challenges": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "phase", "nonce", "pattern", "issued_ms", "deadline_ms", "result"],
        "properties": {
          "id": {"type": "string"}, "role": {"$ref": "#/$defs/role"}, "phase": {"enum": ["kickoff", "halftime", "end"]},
          "nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
          "pattern": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "issued_ms": {"$ref": "#/$defs/ms"}, "deadline_ms": {"$ref": "#/$defs/ms"},
          "issuer": {"type": "object", "description": "Signed qortime-challenge/v1 token from the official referee (review receipts)."},
          "result": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["ok", "reason"],
                     "properties": {"ok": {"type": "boolean"}, "reason": {"type": "string"},
                                    "pause_press_ms": {"type": ["integer", "null"]}, "done_ms": {"type": ["integer", "null"]},
                                    "latency_ms": {"type": ["integer", "null"]}, "hid_sha256": {"$ref": "#/$defs/hex64"}}}]}
        }
      }
    },
    "checkpoints": {"type": "object", "additionalProperties": false,
                    "properties": {"home": {"type": "array", "items": {"$ref": "#/$defs/checkpoint"}},
                                   "away": {"type": "array", "items": {"$ref": "#/$defs/checkpoint"}}}},
    "agreement": {"type": "object", "required": ["timelines_agree", "mismatches"],
                  "properties": {"timelines_agree": {"type": ["boolean", "null"]}, "mismatches": {"type": "array", "items": {"type": "string"}}}},
    "signals": {"type": "object", "properties": {"motion_permille": {"type": "object",
                "additionalProperties": {"type": ["integer", "null"], "minimum": -1000, "maximum": 1000}}}},
    "trust_tier": {"enum": ["dual-attested", "single-attested"]},
    "review": {"type": "object", "description": "Official post-hoc bundle review (qortime-bundle-review/v1); only with referee.key_kind qortime-official-review; covered by the referee signature.",
      "required": ["type", "capture_referee", "checks"],
      "properties": {"type": {"const": "qortime-bundle-review/v1"}, "capture_referee": {"type": "object"},
        "checks": {"type": "object", "additionalProperties": {"type": "object", "required": ["state"], "properties": {"state": {"enum": ["pass", "partial", "fail"]}}}}}},
    "signatures": {"type": "object", "additionalProperties": false, "required": ["players", "referee"],
                   "properties": {"players": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sig"}},
                                  "referee": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sig"}]}}}
  }
}
