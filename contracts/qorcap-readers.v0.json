{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conwan30.github.io/qortime/schema/contracts/qorcap-readers.v0.json",
  "title": "readers.json (qorcap-readers/v0)",
  "description": "Closed manifest of the scorebug and vision reader code and the runtime builds that produced the reads. Checkpoint seq 0 carries $defs/commitment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "qorcap_version", "readers", "runtimes"],
  "properties": {
    "schema": {"const": "qorcap-readers/v0"},
    "qorcap_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "readers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reader"}
    },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Builds that produced the scorebug reads, such as ffmpeg and cv2. id is the build name, sha256 is the build that ran.",
      "items": {"$ref": "#/$defs/runtime"}
    }
  },
  "$defs": {
    "reader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "files"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "version": {"type": "string", "minLength": 1, "maxLength": 80},
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/file"}
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {"enum": ["code", "pack"]},
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!.*(?:^|/)[^/]*(?:\\.| )(?:/|$))(?!.*\\.(?:[Kk][Ee][Yy]|[Pp][Ee][Mm]|[Pp]12|[Pp][Ff][Xx]|[Jj][Ww][Kk]|[Pp][Pp][Kk]|[Jj][Kk][Ss])$)(?!.*(?:^|/)[Kk][Ee][Yy][Ss](?:/|$))(?!.*(?:^|/)[Ss][Ee][Cc][Rr][Ee][Tt][Ss]?(?:/|$))(?!.*(?:^|/)[^/]*_[Kk][Ee][Yy](?:\\.[^/]*)?(?:/|$))(?!.*(?:^|/)[Ii][Dd]_(?:[Rr][Ss][Aa]|[Dd][Ss][Aa]|[Ee][Cc][Dd][Ss][Aa](?:_[Ss][Kk])?|[Ee][Dd]25519(?:_[Ss][Kk])?|[Ee][Dd]448(?:_[Ss][Kk])?)(?:\\.[^/]*)?(?:/|$))(?:[A-Za-z0-9_][A-Za-z0-9_.+-]*/)*[A-Za-z0-9_][A-Za-z0-9_.+-]*$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._+-]{1,80}$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 80},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "commitment": {
      "oneOf": [
        {"$ref": "#/$defs/hashed"},
        {"$ref": "#/$defs/unbound"}
      ]
    },
    "hashed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "sha256"],
      "properties": {
        "schema": {"const": "qorcap-readers/v0"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "unbound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "state"],
      "properties": {
        "schema": {"const": "qorcap-readers/v0"},
        "state": {"const": "unbound"}
      }
    }
  }
}
