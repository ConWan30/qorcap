{
  "clock": [
    {
      "id": "wall_step_back_2s",
      "input": {
        "session_id": "s1",
        "clock_id": "boot1:producer1",
        "clock_source": "monotonic_ns",
        "mono_origin_ns": 9000000000,
        "frames": [
          {
            "capture_id": "a",
            "mono_us": 1000000,
            "wall_time_ms": 1700000003000
          },
          {
            "capture_id": "b",
            "mono_us": 1250000,
            "wall_time_ms": 1700000001000
          }
        ]
      },
      "expected": {
        "verdict": "accept_order",
        "ordered_capture_ids": [
          "a",
          "b"
        ],
        "wall_time_used_for_order": false
      }
    },
    {
      "id": "missing_clock_binding",
      "input": {
        "session_id": "s1",
        "clock_id": null,
        "mono_origin_ns": null,
        "frame": {
          "capture_id": "a",
          "mono_us": 1700000003000000,
          "wall_time_ms": 1700000003000
        }
      },
      "expected": {
        "verdict": "unknown_void",
        "reason": "clock_binding_missing"
      }
    },
    {
      "id": "cross_boot_epoch",
      "input": {
        "session_id": "s1",
        "session_clock_id": "boot1:p1",
        "frames": [
          {
            "capture_id": "a",
            "clock_id": "boot1:p1",
            "mono_us": 9000
          },
          {
            "capture_id": "b",
            "clock_id": "boot2:p2",
            "mono_us": 10
          }
        ]
      },
      "expected": {
        "verdict": "reject_clock_domain",
        "reason": "clock_epoch_mismatch"
      }
    }
  ],
  "capture_evidence": [
    {
      "id": "http_503_frame_2",
      "input": {
        "attempts": [
          {
            "attempt_seq": 1,
            "http_status": 200,
            "capture_id": "a"
          },
          {
            "attempt_seq": 2,
            "http_status": 503
          },
          {
            "attempt_seq": 3,
            "http_status": 200,
            "capture_id": "b"
          }
        ]
      },
      "expected": {
        "verdict": "log_failure",
        "failure": {
          "attempt_seq": 2,
          "kind": "capture_failure",
          "reason_code": "http_error",
          "http_status": 503
        },
        "chain_entry_required": true,
        "final_candidate_reset": true
      }
    },
    {
      "id": "stale_or_missing_provenance",
      "input": {
        "variants": [
          {
            "attempt_seq": 2,
            "source_wall_ms": 1000,
            "now_wall_ms": 3001,
            "max_age_ms": 2000
          },
          {
            "attempt_seq": 2,
            "source_wall_ms": null,
            "capture_generation": null
          }
        ]
      },
      "expected": {
        "verdict": "log_failure",
        "reason_codes": [
          "stale_snapshot",
          "missing_provenance"
        ],
        "chain_entry_required_per_variant": true,
        "candidate_reset": true
      }
    },
    {
      "id": "jpeg_decode_none",
      "input": {
        "attempt_seq": 2,
        "http_status": 200,
        "provenance_valid": true,
        "jpeg_bytes_hex": "ffd8ffd9",
        "decoder_result": null
      },
      "expected": {
        "verdict": "log_failure",
        "reason_code": "decode_error",
        "chain_entry_required": true,
        "no_on_frame": true
      }
    },
    {
      "id": "digit_and_candidates_change_same_status",
      "input": {
        "regions": [
          {
            "capture_id": "a",
            "region": "scoreboard",
            "status": "read",
            "calibrated": true,
            "reason": null,
            "digits": {
              "kills": 7
            },
            "candidates": [
              {
                "value": 7,
                "score_milli": 900
              }
            ]
          },
          {
            "capture_id": "b",
            "region": "scoreboard",
            "status": "read",
            "calibrated": true,
            "reason": null,
            "digits": {
              "kills": 1
            },
            "candidates": [
              {
                "value": 1,
                "score_milli": 900
              }
            ]
          }
        ]
      },
      "expected": {
        "verdict": "emit_both",
        "evidence_hashes_must_differ": true
      }
    }
  ],
  "terminal": [
    {
      "id": "last_three_entries_missing",
      "input": {
        "valid_base_entries": [
          {
            "chain_seq": 0,
            "kind": "set"
          },
          {
            "chain_seq": 1,
            "kind": "hud"
          },
          {
            "chain_seq": 2,
            "kind": "hud"
          },
          {
            "chain_seq": 3,
            "kind": "hud"
          },
          {
            "chain_seq": 4,
            "kind": "hud"
          }
        ],
        "mutations": [
          "drop last 3 data entries but retain original terminal",
          "drop final 3 physical JSONL lines including terminal"
        ]
      },
      "expected": {
        "verdict": "reject_incomplete",
        "reasons": [
          "root_count_seq_mismatch",
          "terminal_missing"
        ]
      }
    },
    {
      "id": "inflated_count_rehashed_terminal",
      "input": {
        "valid_base_data_count": 2,
        "terminal_patch": {
          "entry_count": 9
        },
        "rehash_terminal": true
      },
      "expected": {
        "verdict": "reject",
        "reason": "terminal_count_mismatch"
      }
    },
    {
      "id": "wrong_root_rehashed_terminal",
      "input": {
        "valid_base_data_count": 2,
        "terminal_patch": {
          "chain_root_hash": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
        },
        "rehash_terminal": true
      },
      "expected": {
        "verdict": "reject",
        "reason": "terminal_root_mismatch"
      }
    },
    {
      "id": "explicit_truncation_rehashed_terminal",
      "input": {
        "valid_base_data_count": 2,
        "terminal_patch": {
          "truncated": true
        },
        "rehash_terminal": true
      },
      "expected": {
        "verdict": "unknown_void",
        "reason": "chain_truncated",
        "structural_integrity_may_pass": true
      }
    }
  ],
  "durable_append": [
    {
      "id": "flush_error",
      "input": {
        "binding_revision": 1,
        "write_all": "ok",
        "flush": "EIO",
        "sync_all": "not_reached"
      },
      "expected": {
        "verdict": "append_failed",
        "seal_ack": false,
        "pending_revision": 1,
        "broadcast_success": false
      }
    },
    {
      "id": "sync_error_then_retry",
      "input": {
        "binding_revision": 1,
        "attempts": [
          {
            "write_all": "ok",
            "flush": "ok",
            "sync_all": "EIO"
          },
          {
            "write_all": "ok",
            "flush": "ok",
            "sync_all": "ok"
          }
        ]
      },
      "expected": {
        "verdict": "retry_then_commit",
        "seal_ack_by_attempt": [
          false,
          true
        ],
        "same_binding_revision": true,
        "durable_duplicate_count": 0
      }
    },
    {
      "id": "partial_write_then_retry",
      "input": {
        "binding_revision": 1,
        "attempts": [
          {
            "bytes_written": 7,
            "write_all": "ENOSPC"
          },
          {
            "write_all": "ok",
            "flush": "ok",
            "sync_all": "ok"
          }
        ]
      },
      "expected": {
        "verdict": "retry_only_after_torn_tail_recovery",
        "seal_ack_before_recovery": false,
        "valid_jsonl_and_contiguous_chain_after_retry": true
      }
    }
  ],
  "reopen": [
    {
      "id": "old_incoming_before_new_process",
      "input": {
        "prior": {
          "capture_generation": 1,
          "capture_id": "old",
          "incoming_hex": "ffd811ffd9"
        },
        "reopen": {
          "capture_generation": 2,
          "new_process_started": false,
          "incoming_hex": "ffd811ffd9"
        }
      },
      "expected": {
        "verdict": "reject_stale_generation",
        "http_status": 503,
        "new_source_timestamp_assigned": false
      }
    },
    {
      "id": "new_generation_same_pixels",
      "input": {
        "prior": {
          "capture_generation": 1,
          "capture_id": "g1:1",
          "pixels_sha256": "same"
        },
        "new": {
          "capture_generation": 2,
          "producer_sequence": 1,
          "capture_id": "g2:1",
          "producer_frame_completion": true,
          "pixels_sha256": "same",
          "mono_us": 3000000
        }
      },
      "expected": {
        "verdict": "accept_new_capture_provenance",
        "frame_content_alone_is_not_capture_id": true,
        "consensus_may_still_abstain_repeated_pixels": true,
        "real_match_artifacts_changed": false
      }
    }
  ],
